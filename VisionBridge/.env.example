# Render (and other hosts) set PORT automatically — do not hardcode in production.
PORT=5000

# Bind address (Render expects 0.0.0.0)
HOST=0.0.0.0

# Required for production: comma-separated frontend origins (no trailing slashes)
# Example (Vercel):
# CORS_ORIGIN=https://your-app.vercel.app
# Multiple:
# CORS_ORIGIN=https://your-app.vercel.app,https://www.yourdomain.com

# Optional: Node environment
# NODE_ENV=production

# --- Firebase Admin (required for privileged Socket.IO events) ---
# Prefer a single JSON secret on Render/Vercel-style hosts:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
# Or split fields (escape newlines in PRIVATE_KEY as \n):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
#
# Or point to a local service account file (local only; never commit the file):
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# --- PostgreSQL / Supabase (backend-only, optional but required for persistence) ---
# Use the Supabase/Postgres connection string (pooler or direct). Do NOT commit real values.
# Example placeholders:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For Supabase pooler (recommended on Render), use the provided connection string and SSL.
DATABASE_URL=

# TLS certificate verification (recommended/required for Supabase): provide Supabase CA and enable verification.
# DATABASE_SSL_CA_FILE=/path/to/supabase-ca.crt
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# SSL behavior: auto-detected (hosted => SSL with certificate verification by default). Override only if needed.
# DATABASE_SSL=true
# DATABASE_SSL=verify-full

# Connection pool size (default 10)
# DATABASE_POOL_MAX=10
